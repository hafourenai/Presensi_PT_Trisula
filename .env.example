# Public portal origins. Point both DNS A records to the VPS first.
EMPLOYEE_ORIGIN=https://presensi.trisulaprimaagung.my.id
ADMIN_ORIGIN=https://admin.trisulaprimaagung.my.id
EMPLOYEE_DOMAIN=presensi.trisulaprimaagung.my.id
ADMIN_DOMAIN=admin.trisulaprimaagung.my.id
INTERNAL_HOSTS=127.0.0.1,localhost
APP_PORT=3002

# Supabase project API credentials.
PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Optional Telegram attendance notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only needed when bootstrapping the first administrator.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NIP=
INITIAL_ADMIN_NAME=

# Only needed during an explicit administrator rotation.
ROTATION_ADMIN_EMAIL=
ROTATION_ADMIN_PASSWORD=
ROTATION_ADMIN_NIP=
ROTATION_ADMIN_NAME=
PREVIOUS_ADMIN_ROLE=admin_hr
DEACTIVATE_PREVIOUS_ADMIN=false
