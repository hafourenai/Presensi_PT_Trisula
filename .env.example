# Supabase Dashboard > Connect: Project URL
PUBLIC_SUPABASE_URL=
# Supabase Dashboard > Settings > API Keys: Publishable key
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Khusus server. Jangan beri prefix PUBLIC_ atau kirim nilainya lewat chat.
SUPABASE_SECRET_KEY=

# Bootstrap administrator pertama (CLI lokal npm run seed:admin).
# Isi identitas asli dan password awal minimal 12 karakter.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NIP=
INITIAL_ADMIN_NAME=

# Telegram Alerts (Opsional - untuk notifikasi deteksi perangkat / anomali ke HR)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
